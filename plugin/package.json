{
  "name": "dsh-yukkuri-tts",
  "version": "0.3.1",
  "private": true,
  "description": "DSH 油库里朗读插件的开发清单（跑测试用）。对外发布的是仓库根那份同名 package.json —— core 随包分发，不单独装。",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:fast": "node --test"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODO-TECH/dsh-yukkuli.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/ODO-TECH/dsh-yukkuli#readme",
  "bugs": {
    "url": "https://github.com/ODO-TECH/dsh-yukkuli/issues"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
